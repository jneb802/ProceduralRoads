        <Compile Include="../ProceduralRoads/Src/Roads/RoadTerrainSamples.cs" Link="ModSrc/RoadTerrainSamples.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/ApproachTerrainSamples.cs" Link="ModSrc/ApproachTerrainSamples.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadSwitchbacks.cs" Link="ModSrc/RoadSwitchbacks.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadSiteProtection.cs" Link="ModSrc/RoadSiteProtection.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadPathPull.cs" Link="ModSrc/RoadPathPull.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadWiggle.cs" Link="ModSrc/RoadWiggle.cs"/>
