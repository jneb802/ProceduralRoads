<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          net48 matches the mod's own target and runs under Mono (closest to
          Valheim's in-game runtime); net10.0 is the fast local loop that
          `dotnet test` uses. Run net48 via run-tests.sh (mono + xunit console).
        -->
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>10</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>ProceduralRoads.Tests</RootNamespace>
        <!-- CS8602/8604 fire only because shim types are null-annotated where the game's aren't -->
        <NoWarn>$(NoWarn);CS8602;CS8604</NoWarn>
    </PropertyGroup>

    <!--
      Compile real mod sources against the shims in Shims/ instead of the
      Unity/Valheim/BepInEx assemblies. Only pure-logic files can be listed
      here; anything touching Harmony patches or engine runtime cannot.
    -->
    <ItemGroup>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadConstants.cs" Link="ModSrc/RoadConstants.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadPathfinder.cs" Link="ModSrc/RoadPathfinder.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadNetworkGenerator.cs" Link="ModSrc/RoadNetworkGenerator.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadSpatialGrid.cs" Link="ModSrc/RoadSpatialGrid.cs"/>
        <Compile Include="../ProceduralRoads/Src/Utils/BiomeBlendedHeight.cs" Link="ModSrc/BiomeBlendedHeight.cs"/>
        <Compile Include="../ProceduralRoads/Src/Utils/IslandDetector.cs" Link="ModSrc/IslandDetector.cs"/>
        <Compile Include="../ProceduralRoads/Src/Roads/RoadRoute.cs" Link="ModSrc/RoadRoute.cs"
                 Condition="Exists('../ProceduralRoads/Src/Roads/RoadRoute.cs')"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0"/>
        <PackageReference Include="xunit" Version="2.8.1"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1"/>
        <PackageReference Include="xunit.runner.console" Version="2.8.1">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
