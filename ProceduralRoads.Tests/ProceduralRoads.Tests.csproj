<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><ToolkitPackageVersion Condition="'$(ToolkitPackageVersion)' == ''">0.1.0-preview.13</ToolkitPackageVersion><DoublesPackageVersion Condition="'$(DoublesPackageVersion)' == ''">0.1.0-preview.14</DoublesPackageVersion></PropertyGroup>

    <PropertyGroup>
        <!--
          net48 matches the mod's own target and runs under Mono (closest to
          Valheim's in-game runtime); net10.0 is the fast local loop that
          `dotnet test` uses. run-tests.sh runs both (net48 under Mono on macOS/Linux).
        -->
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>10</LangVersion>
        <Nullable>enable</Nullable>
        <DefineConstants>$(DefineConstants);ROADS_TESTS</DefineConstants>
        <IsPackable>false</IsPackable>
        <RootNamespace>ProceduralRoads.Tests</RootNamespace>
        <!-- CS8602/8604 fire only because shim types are null-annotated where the game's aren't -->
        <NoWarn>$(NoWarn);CS8602;CS8604</NoWarn>
    </PropertyGroup>

    <!--
      Compile real mod sources against the doubles (Valheim.Testing.Doubles, plus
      Roads-only additions in Shims/) instead of the Unity/Valheim/BepInEx assemblies. Only pure-logic files can be listed
      here; anything touching Harmony patches or engine runtime cannot.
    -->
    <ItemGroup>
        <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

